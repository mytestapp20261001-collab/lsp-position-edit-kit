              "character": 0
            }
          },
          "replacement": "prefix "
        },
        {
          "source": "prefix \ud83d\ude00 x y\n",
          "byte_span": [
            12,
            13
          ],
          "expected_range": {
            "start": {
              "line": 0,
              "character": 10
            },
            "end": {
              "line": 0,
              "character": 11
            }
          },
          "replacement": "renamed"
        },
