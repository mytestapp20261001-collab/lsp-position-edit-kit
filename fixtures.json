        {
          "source": "alpha beta\n",
          "byte_span": [
            6,
            10
          ],
          "expected_range": {
            "start": {
              "line": 0,
              "character": 6
            },
            "end": {
              "line": 0,
              "character": 10
            }
          },
          "replacement": "B"
        }
      ],
      "expected_text": "alpha B\n"
    },
